rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default: Deny all reads and writes across the database
    match /{document=**} {
      allow read, write: if false;
    }

    // Customer Accounts: Owner-only access
    // Users can strictly read and write ONLY their own user document and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Orders subcollection: strictly owner-only
      match /orders/{orderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Any future nested subcollections under user
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
